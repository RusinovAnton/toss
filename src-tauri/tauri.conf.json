{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toss",
  "version": "0.1.0",
  "identifier": "dev.toss.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toss",
        "width": 480,
        "height": 480,
        "minWidth": 360,
        "minHeight": 360,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE",
    "shortDescription": "LocalSend-compatible file transfer, shaped like a radar",
    "longDescription": "Toss sends files and folders to other devices on your local network. It speaks the LocalSend protocol, so it interoperates with the official LocalSend app. No account, no cloud, no telemetry.",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Toss contributors",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
